{
  "name": "cartridge",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic generator for single-file HTML5 mini-games, with an explicit workflow graph and a two-tier evaluator",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:vercel": "node scripts/build-vercel.ts",
    "check:clean-room": "node scripts/clean-room-scan.ts",
    "dev": "node --env-file-if-exists=.env src/server/dev.ts",
    "eval:one": "node --env-file-if-exists=.env src/eval/cli.ts run --tier one",
    "eval:sample": "node --env-file-if-exists=.env src/eval/cli.ts run --tier sample",
    "eval:full": "node --env-file-if-exists=.env src/eval/cli.ts run --tier full",
    "eval:rescore": "node src/eval/cli.ts score --games games --json reports/committed/full.json",
    "eval:score": "node src/eval/cli.ts score --games games",
    "eval:matrix": "node src/eval/cli.ts matrix --json reports/committed/matrix.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.62",
    "@ai-sdk/provider": "4.0.18",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.70.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.0.0",
    "ai": "7.0.113",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.0"
  }
}
