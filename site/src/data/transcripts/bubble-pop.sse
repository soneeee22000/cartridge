data: {"status":"complete","artifact":{"version":"a1","sha256":"94cdbd634c3489ac1a1196b20e43f9268e8c3c1153f05365f399bb1153383f9b","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pop the Bubbles</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    height: 100%;\n    background: #f4ecd8;\n    overflow: hidden;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n  #wrap {\n    position: fixed;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n  }\n  canvas {\n    display: block;\n    touch-action: none;\n    flex: 1;\n  }\n  #hud {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 10px 14px;\n    box-sizing: border-box;\n    pointer-events: none;\n  }\n  #tally {\n    background: #e07a5f;\n    color: #f4ecd8;\n    font-weight: 800;\n    font-size: 18px;\n    padding: 8px 16px;\n    border-radius: 14px;\n    box-shadow: 0 3px 6px rgba(61,64,91,0.3);\n  }\n  #clearBtn {\n    pointer-events: auto;\n    background: #3d405b;\n    color: #f4ecd8;\n    border: none;\n    font-weight: 800;\n    font-size: 16px;\n    padding: 10px 18px;\n    min-height: 44px;\n    border-radius: 14px;\n    box-shadow: 0 3px 6px rgba(61,64,91,0.3);\n    cursor: pointer;\n  }\n  #clearBtn:active {\n    transform: translateY(1px);\n  }\n</style>\n</head>\n<body>\n<div id=\"wrap\">\n  <div id=\"hud\">\n    <div id=\"tally\">Pops: 0</div>\n    <button id=\"clearBtn\">Clear Table</button>\n  </div>\n  <canvas id=\"game\"></canvas>\n</div>\n<script>\nconst CARTRIDGE = {\n  send(type, payload = {}) {\n    window.parent.postMessage(\n      { source: \"cartridge\", v: 1, type, payload },\n      \"*\",\n    );\n  },\n};\n</script>\n<script>\n(function() {\n  const canvas = document.getElementById(\"game\");\n  const ctx = canvas.getContext(\"2d\");\n  const tallyEl = document.getElementById(\"tally\");\n  const clearBtn = document.getElementById(\"clearBtn\");\n\n  let dpr = window.devicePixelRatio || 1;\n  let W = 0, H = 0;\n\n  function resize() {\n    W = window.innerWidth;\n    H = window.innerHeight;\n    dpr = window.devicePixelRatio || 1;\n    canvas.width = Math.floor(W * dpr);\n    canvas.height = Math.floor(H * dpr);\n    canvas.style.width = W + \"px\";\n    canvas.style.height = H + \"px\";\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n  window.addEventListener(\"resize\", resize);\n  resize();\n\n  // seeded jitter helper for paper-cut edges\n  function seededRand(seed) {\n    let s = seed;\n    return function() {\n      s = (s * 9301 + 49297) % 233280;\n      return s / 233280;\n    };\n  }\n\n  const PALETTE = {\n    background: \"#f4ecd8\",\n    layer: \"#e07a5f\",\n    accent: \"#3d405b\",\n    highlight: \"#81b29a\"\n  };\n\n  const bubbleColors = [PALETTE.layer, PALETTE.highlight, PALETTE.accent];\n\n  let running = false;\n  let paused = false;\n  let tally = 0;\n  const bubbles = [];\n  let bubbleId = 0;\n  const pops = []; // pop animations\n\n  const MAX_BUBBLES = 9;\n\n  function rand(min, max) {\n    return min + Math.random() * (max - min);\n  }\n\n  function spawnBubble() {\n    const r = rand(28, 48);\n    const x = rand(r + 10, Math.max(r + 20, W - r - 10));\n    const y = H + r + rand(0, 200);\n    const speed = rand(0.4, 1.0);\n    const wobbleSeed = Math.floor(rand(1, 99999));\n    const color = bubbleColors[Math.floor(rand(0, bubbleColors.length))];\n    bubbles.push({\n      id: bubbleId++,\n      x, y, r,\n      speed,\n      color,\n      wobblePhase: rand(0, Math.PI * 2),\n      seed: wobbleSeed\n    });\n  }\n\n  function ensureBubbles() {\n    while (bubbles.length < MAX_BUBBLES) {\n      spawnBubble();\n    }\n  }\n\n  // clearTable is THE single function that resets everything:\n  // clears pieces, zeroes tally, sends score, redraws.\n  // It is called both by the host \"reset\" command and by the\n  // visible Clear Table button. It also returns the toy to the\n  // pre-start title screen, matching the toy-box \"hard reset\" contract.\n  function clearTable() {\n    running = false;\n    bubbles.length = 0;\n    pops.length = 0;\n    tally = 0;\n    tallyEl.textContent = \"Pops: 0\";\n    CARTRIDGE.send(\"score\", { value: 0 });\n    draw();\n  }\n\n  clearBtn.addEventListener(\"click\", clearTable);\n\n  window.addEventListener(\"message\", (event) => {\n    const data = event.data;\n    if (!data || data.source !== \"cartridge-host\") return;\n    if (data.type === \"pause\") paused = true;\n    if (data.type === \"resume\") paused = false;\n    if (data.type === \"reset\") clearTable();\n  });\n\n  function popBubble(b) {\n    bubbles.splice(bubbles.indexOf(b), 1);\n    tally += 1;\n    tallyEl.textContent = \"Pops: \" + tally;\n    CARTRIDGE.send(\"score\", { value: tally });\n    pops.push({ x: b.x, y: b.y, r: b.r, t: 0, color: b.color });\n  }\n\n  function hitTest(px, py) {\n    for (let i = bubbles.length - 1; i >= 0; i--) {\n      const b = bubbles[i];\n      const dx = px - b.x;\n      const dy = py - b.y;\n      if (dx * dx + dy * dy <= b.r * b.r * 1.15) {\n        return b;\n      }\n    }\n    return null;\n  }\n\n  canvas.style.touchAction = \"none\";\n  canvas.addEventListener(\"pointerdown\", (event) => {\n    event.preventDefault();\n    if (paused) return;\n    if (!running) {\n      running = true;\n      CARTRIDGE.send(\"start\");\n      ensureBubbles();\n      return;\n    }\n    const rect = canvas.getBoundingClientRect();\n    const px = event.clientX - rect.left;\n    const py = event.clientY - rect.top;\n    const hit = hitTest(px, py);\n    if (hit) {\n      popBubble(hit);\n    }\n  });\n\n  function settle() {\n    for (let i = bubbles.length - 1; i >= 0; i--) {\n      const b = bubbles[i];\n      b.y -= b.speed;\n      b.wobblePhase += 0.02;\n      b.x += Math.sin(b.wobblePhase) * 0.3;\n      if (b.y < -b.r - 20) {\n        bubbles.splice(i, 1);\n      }\n    }\n    if (running) ensureBubbles();\n    for (let i = pops.length - 1; i >= 0; i--) {\n      pops[i].t += 1;\n      if (pops[i].t > 14) pops.splice(i, 1);\n    }\n  }\n\n  function drawJitterCircle(cx, cy, r, seed, fillStyle) {\n    const rnd = seededRand(seed);\n    const points = 14;\n    ctx.beginPath();\n    for (let i = 0; i <= points; i++) {\n      const angle = (i / points) * Math.PI * 2;\n      const jitter = (rnd() - 0.5) * 2.2;\n      const rr = r + jitter;\n      const x = cx + Math.cos(angle) * rr;\n      const y = cy + Math.sin(angle) * rr;\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.closePath();\n    ctx.fillStyle = fillStyle;\n    ctx.fill();\n  }\n\n  function drawBackground() {\n    ctx.fillStyle = PALETTE.background;\n    ctx.fillRect(0, 0, W, H);\n    // subtle layered strips at bottom for paper-cut depth\n    ctx.save();\n    ctx.shadowColor = \"rgba(61,64,91,0.25)\";\n    ctx.shadowBlur = 6;\n    ctx.shadowOffsetY = 3;\n    const rnd = seededRand(777);\n    ctx.beginPath();\n    ctx.moveTo(0, H);\n    for (let x = 0; x <= W; x += 40) {\n      const jitter = (rnd() - 0.5) * 6;\n      ctx.lineTo(x, H - 30 + jitter);\n    }\n    ctx.lineTo(W, H);\n    ctx.closePath();\n    ctx.fillStyle = PALETTE.highlight;\n    ctx.globalAlpha = 0.5;\n    ctx.fill();\n    ctx.globalAlpha = 1;\n    ctx.restore();\n  }\n\n  function draw() {\n    drawBackground();\n\n    if (!running) {\n      drawTitleScreen();\n      return;\n    }\n\n    // bubbles with shadow layer\n    for (const b of bubbles) {\n      ctx.save();\n      ctx.shadowColor = \"rgba(61,64,91,0.3)\";\n      ctx.shadowBlur = 6;\n      ctx.shadowOffsetY = 3;\n      drawJitterCircle(b.x, b.y, b.r, b.seed, b.color);\n      ctx.restore();\n\n      // inner highlight circle (paper layer stacked)\n      ctx.save();\n      drawJitterCircle(b.x - b.r * 0.25, b.y - b.r * 0.25, b.r * 0.35, b.seed + 5, PALETTE.background);\n      ctx.globalAlpha = 0.5;\n      ctx.restore();\n    }\n\n    // pop animations\n    for (const p of pops) {\n      const progress = p.t / 14;\n      const rr = p.r * (1 + progress * 0.8);\n      ctx.save();\n      ctx.globalAlpha = Math.max(0, 1 - progress);\n      ctx.strokeStyle = PALETTE.accent;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      const spikes = 8;\n      for (let i = 0; i < spikes; i++) {\n        const angle = (i / spikes) * Math.PI * 2;\n        const x1 = p.x + Math.cos(angle) * rr * 0.6;\n        const y1 = p.y + Math.sin(angle) * rr * 0.6;\n        const x2 = p.x + Math.cos(angle) * rr;\n        const y2 = p.y + Math.sin(angle) * rr;\n        ctx.moveTo(x1, y1);\n        ctx.lineTo(x2, y2);\n      }\n      ctx.stroke();\n      ctx.restore();\n    }\n  }\n\n  let hintPhase = 0;\n  function drawTitleScreen() {\n    hintPhase += 0.06;\n    const cx = W / 2;\n    const cy = H / 2;\n\n    // title plate\n    ctx.save();\n    ctx.shadowColor = \"rgba(61,64,91,0.3)\";\n    ctx.shadowBlur = 6;\n    ctx.shadowOffsetY = 3;\n    const plateW = Math.min(320, W * 0.8);\n    const plateH = 90;\n    roundRect(cx - plateW / 2, cy - 120, plateW, plateH, 16);\n    ctx.fillStyle = PALETTE.layer;\n    ctx.fill();\n    ctx.restore();\n\n    ctx.fillStyle = PALETTE.background;\n    ctx.font = \"800 26px sans-serif\";\n    ctx.textAlign = \"center\";\n    ctx.textBaseline = \"middle\";\n    ctx.fillText(\"Pop the Bubbles\", cx, cy - 75);\n\n    // pulsing hint\n    const alpha = 0.6 + 0.4 * Math.sin(hintPhase);\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = PALETTE.accent;\n    ctx.font = \"700 20px sans-serif\";\n    ctx.fillText(\"Tap to begin\", cx, cy + 20);\n    ctx.restore();\n\n    // decorative bubble samples\n    drawJitterCircle(cx - 80, cy + 90, 26, 12, PALETTE.highlight);\n    drawJitterCircle(cx, cy + 100, 32, 34, PALETTE.layer);\n    drawJitterCircle(cx + 80, cy + 90, 22, 56, PALETTE.accent);\n  }\n\n  function roundRect(x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.arcTo(x + w, y, x + w, y + h, r);\n    ctx.arcTo(x + w, y + h, x, y + h, r);\n    ctx.arcTo(x, y + h, x, y, r);\n    ctx.arcTo(x, y, x + w, y, r);\n    ctx.closePath();\n  }\n\n  function frame() {\n    if (!paused) settle();\n    draw();\n    requestAnimationFrame(frame);\n  }\n\n  CARTRIDGE.send(\"boot\", { title: \"Pop the Bubbles\", gameType: \"toy-box\", lang: \"en\" });\n  requestAnimationFrame(() => {\n    draw();\n    requestAnimationFrame(frame);\n  });\n})();\n</script>\n</body>\n</html>\n"},"e1Score":1}

